# pnpm 11 runs a dependency-status check before `pnpm run <script>` that shells
# out to `pnpm install`; with build scripts intentionally gated that check exits
# non-zero and blocks typecheck/build. The build allowlist lives in
# pnpm-workspace.yaml (onlyBuiltDependencies); we don't need the pre-run guard.
verify-deps-before-run=false
