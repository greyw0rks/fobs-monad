// Fobs (Monad) — data model.
//
// The social + trading surface is built from one activity graph: Users (wallet =
// identity), the Tokens they trade, the Trades themselves (feed, profiles and
// token activity all read from this), Positions, and Follows.
//
// HONESTY RULE: no market numbers live in the DB. Token rows hold IDENTITY ONLY
// (address + decimals) purely so Trades can hold a foreign key; prices, 24h
// change, volume and market cap are fetched live from the market provider at
// request time (lib/market.ts) and never persisted. Fobs Signal and trader stats
// are COMPUTED from Trades at read time (lib/signal.ts), not stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Neon this is the POOLED endpoint: the pooler queues
  // client connections through a compute wake-up instead of failing them, which
  // matters because a scale-to-zero compute otherwise refuses the first
  // connection after an idle period (P1001).
  url      = env("DATABASE_URL")
  // DDL connection (db push / migrate). The pooler must not be used for
  // schema changes.
  directUrl = env("DIRECT_URL")
}

enum TradeSide {
  BUY
  SELL
}

enum TradeSource {
  SWAP // Monad-native swap, user-signed
  CROSS_CHAIN // funded from another chain, settled on Monad
}

enum NotificationType {
  FOLLOW
  NOTABLE_TRADE
  TRADE_FILLED
}

model User {
  id          String   @id @default(cuid())
  address     String   @unique // wallet address, lowercased — the identity
  username    String   @unique
  displayName String
  avatar      String?
  bio         String?
  isNotable   Boolean  @default(false) // derived signal in a later milestone; never seeded
  createdAt   DateTime @default(now())

  trades        Trade[]
  positions     Position[]
  following     Follow[]       @relation("follower")
  followers     Follow[]       @relation("following")
  notifications Notification[] @relation("recipient")
  actedOn       Notification[] @relation("actor")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// Identity only — every market figure is fetched live, never stored here.
model Token {
  symbol    String   @id // e.g. "MON" — natural key, uppercase
  name      String
  address   String // ERC20 contract on Monad (WMON for native MON)
  chain     String   @default("monad")
  decimals  Int      @default(18)
  logo      String?
  createdAt DateTime @default(now())

  trades    Trade[]
  positions Position[]
}

model Trade {
  id          String      @id @default(cuid())
  userId      String
  tokenSymbol String
  side        TradeSide
  amountToken Float // token units, derived from the verified receipt
  amountUsd   Float // notional at execution, derived from the verified receipt
  priceUsd    Float // effective fill price (amountUsd / amountToken)
  chain       String      @default("monad")
  fromChain   String? // funding source chain for cross-chain buys
  txHash      String? @unique // the real on-chain tx; unique so records are idempotent
  source      TradeSource @default(SWAP)
  createdAt   DateTime    @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token Token @relation(fields: [tokenSymbol], references: [symbol], onDelete: Cascade)

  @@index([tokenSymbol, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Written only once real trade history can be reconstructed (indexer milestone).
// Until then the portfolio reads live on-chain balances and shows no PnL rather
// than a fabricated average entry.
model Position {
  id             String   @id @default(cuid())
  userId         String
  tokenSymbol    String
  amount         Float // current token units held
  avgEntryUsd    Float // average entry price
  realizedPnlUsd Float    @default(0)
  updatedAt      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token Token @relation(fields: [tokenSymbol], references: [symbol], onDelete: Cascade)

  @@unique([userId, tokenSymbol])
  @@index([userId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  tokenSymbol String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User  @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, read])
}

// A single-use challenge for signature auth. Writes are authorised by the
// wallet that owns them: the client asks for a nonce, signs `message` verbatim,
// and the route verifies the signature against this stored copy — never against
// a client-supplied one. Single-use, so a captured signature cannot be replayed,
// and bound to `action`, so a signature for one target cannot authorise another.
model AuthNonce {
  nonce     String    @id // 32 random bytes, hex
  address   String // the wallet the nonce was issued to, lowercased
  action    String // e.g. "follow:@alice" — must match the request being made
  message   String // the exact string the client was told to sign
  expiresAt DateTime
  usedAt    DateTime? // set atomically on first successful verification
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

