# Fobs (Monad) — environment. Every key here is server-side only unless it is
# prefixed NEXT_PUBLIC_ (those ship to the browser).

# PostgreSQL (Neon). Required for the social/activity graph and trade records.
# The app degrades to honest empty states (and the token/explore pages still
# work off the registry + live prices) when this is unset.
#
# Two URLs on purpose — Neon's compute scales to zero, and an unpooled
# connection to a suspended compute is refused (P1001) rather than queued:
#   DATABASE_URL — the POOLED endpoint (host contains "-pooler", add
#     `?pgbouncer=true&connect_timeout=15`). Used by the app at runtime.
#   DIRECT_URL   — the unpooled endpoint. Used only for DDL
#     (`prisma db push` / `prisma migrate`).
DATABASE_URL=
DIRECT_URL=

# 0x Swap API key — server-only. FALLBACK swap routing on Monad (chainId 143),
# used only when Kuru has no route for a pair.
# Free key from the 0x dashboard: https://dashboard.0x.org/
ZEROX_API_KEY=

# Kuru Flow — the PRIMARY swap router (Monad-native). Public; a per-wallet JWT is
# fetched automatically. Override only to point at a different deployment.
KURU_FLOW_URL=https://ws.kuru.io

# Nansen — wallet labels / smart-money. Server-only, PAID, and Monad coverage is
# unverified. When unset, every label reader returns null and the UI renders
# nothing (never a fabricated label).
NANSEN_API_KEY=
NANSEN_API_BASE=https://api.nansen.ai

# Envio indexer GraphQL endpoint (Stage 2). Until set, the feed reads the app's
# own recorded trades.
ENVIO_INDEXER_URL=

# Cross-chain funding INTO Monad (Ethereum, Base, Arbitrum, Optimism, Polygon,
# BNB Chain → MON/USDC/USDT0). Two providers, both keyless/server-side:
#   Relay  — PRIMARY. It is the one that actually routes to Monad. No API key.
#   Aurora — FALLBACK. Its token list advertises Monad assets (HOT-Bridge minted)
#            but its solver has NO Monad pair (verified live 2026-10-06), so it
#            only answers when Relay fails. The appKey is a PATH SEGMENT in
#            Aurora's URLs and never reaches the client. Create a key at
#            https://docs.intents.aurora.dev/intents-swap/api-keys-and-fees
RELAY_API_URL=https://api.relay.link
AURORA_INTENTS_API_URL=https://intents-api.aurora.dev
AURORA_INTENTS_API_KEY=

# Monad mainnet RPC (public default used if unset). Server reads + client wallet
# transport both use this.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz

# Public base URL (used for share-card links / OG images).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
