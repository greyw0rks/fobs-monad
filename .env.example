# Fobs (Monad) — environment

# PostgreSQL. Local: postgres://user:pass@localhost:5432/fobs_monad
# Or a Neon connection string (matches the Vercel deploy workflow).
# The app soft-degrades to empty state when this is unset, but the seeded
# demo needs it. SQLite alternative: set provider="sqlite" in schema.prisma
# and DATABASE_URL="file:./dev.db".
DATABASE_URL=

# Monad testnet RPC (public default used if unset).
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Optional: register the demo wallet as the owner account on `npm run seed`.
SEED_ADDRESS=
SEED_USERNAME=
SEED_DISPLAY_NAME=

# Public base URL (used for share-card links / OG images).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
